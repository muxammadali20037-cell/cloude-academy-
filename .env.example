# Claude Academy — muhit o'zgaruvchilari namunasi.
# Bu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# Haqiqiy qiymatlar HECH QACHON gitga yuklanmaydi.
# NEXT_PUBLIC_ bilan boshlanganlari brauzerga chiqadi — ularga maxfiy kalit yozilmaydi.
# Kiritilmagan servis platformada "NOT CONFIGURED" deb ko'rsatiladi.

# --- Ilova ---
APP_URL=http://localhost:3000
CRON_SECRET=

# --- Supabase (3-faza) — secret kalit faqat serverda ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Claude API (5-faza) ---
ANTHROPIC_API_KEY=

# --- To'lovlar (9-faza) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# --- Telegram (8-faza) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Video (3-faza): bunny | mux ---
VIDEO_PROVIDER=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Ovoz / TTS (6-faza): azure | elevenlabs | aisha ---
TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
AISHA_API_KEY=

# --- Kirish kodlari ---
# Email kodlarini Supabase Auth yuboradi: SMTP Supabase panelida sozlanadi
# (Authentication → Emails → SMTP Settings), bu yerda emas.
# Telefon orqali kirish uchun SMS provayder (masalan, Eskiz):
SMS_PROVIDER_API_KEY=

# --- Monitoring (10-faza) ---
SENTRY_DSN=
