      "purpose": "what",
      "scene": "browser",
      "actions": [{ "do": "reveal", "target": "notice" }],
      "highlight": "notice",
      "text": "Birinchi marta kirsangiz, avval email yoki Google orqali akkaunt yaratasiz."
