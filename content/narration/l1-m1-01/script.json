      "purpose": "error",
      "scene": "fix",
      "actions": [{ "do": "reveal", "target": "heading" }],
      "text": "Agar biror narsa ishlamasa, xavotir olmang. Koʻp uchraydigan holatlarni koʻrib chiqamiz."
