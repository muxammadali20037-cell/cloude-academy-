    {
      "id": "c13",
      "purpose": "what",
      "scene": "browser",
      "actions": [
        {
          "do": "type",
          "target": "input",
          "text": "Men buxgalterman. Claude ish kunimda qaysi 3 ta vazifada yordam bera oladi? Aniq misollar bilan tushuntir."
        }
      ],
      "text": "Savolimizni yozamiz: avval kasbimizni aytamiz, keyin aniq misollar soʻraymiz."
    },
    {
      "id": "c14",
      "purpose": "why",
      "scene": "browser",
      "highlight": "focus",
      "text": "Kasbingizni yozganingiz uchun Claude javobni aynan sizning ishingizga moslab beradi."
